# ---------------------------------------------------------------------------
# Participant AI Assistant — example configuration.
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# --- Whistle / WeWhistle loyalty API ---------------------------------------
# Base URL of the loyalty platform API.
WHISTLE_BASE_URL=https://test.wewhistle.com

# Authentication. Provide EITHER a long-lived API token OR username/password
# (used to obtain a token at runtime). Credentials are read from the
# environment only — they are never stored in source control.
WHISTLE_API_TOKEN=
WHISTLE_USERNAME=
WHISTLE_PASSWORD=

# Optional: override individual API paths if the tenant differs.
WHISTLE_AUTH_PATH=/api/auth/login
WHISTLE_TIMEOUT_SECONDS=30

# --- LLM provider -----------------------------------------------------------
# Supported: "openai" (OpenAI-compatible HTTP API) or "echo" (offline mock).
LLM_PROVIDER=echo
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30

# Used when LLM_PROVIDER=openai. Works with OpenAI and Azure/OpenAI-compatible
# gateways by overriding LLM_BASE_URL.
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# --- RAG knowledge base -----------------------------------------------------
# Directory containing the markdown/text knowledge documents.
KNOWLEDGE_BASE_DIR=data/knowledge_base
RAG_TOP_K=4
