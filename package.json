{
  "name": "participant-ai-assistant",
  "version": "1.0.0",
  "description": "AI Assistant for Loyalty Program Participants using RAG, LLM and Node.js",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "lint": "node --check src/**/*.js"
  },
  "keywords": [
    "loyalty",
    "ai",
    "rag",
    "llm",
    "nodejs",
    "openai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "openai": "^4.104.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "pptxgenjs": "^4.0.1",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "clearMocks": true
  }
}
